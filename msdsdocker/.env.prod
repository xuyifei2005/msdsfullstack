# MSDS生产环境配置文件
# 服务器: 39.107.211.72 (flymsds.cn)

# ====================
# 数据库配置
# ====================
MYSQL_ROOT_PASSWORD=FlyMsds2025Root!@#
MYSQL_PASSWORD=FlyMsds2025Prod!@#

# ====================
# Redis配置
# ====================
REDIS_PASSWORD=FlyMsds2025Redis!@#

# ====================
# 应用配置
# ====================
SPRING_PROFILE=prod

# ====================
# 服务器配置
# ====================
SERVER_IP=39.107.211.72
DOMAIN_NAME=flymsds.cn

# ====================
# 端口配置
# ====================
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# ====================
# 时区配置
# ====================
TZ=Asia/Shanghai

# ====================
# JVM配置
# ====================
JAVA_OPTS=-Xms1024m -Xmx2048m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ====================
# 镜像仓库配置 (可选)
# ====================
REGISTRY=registry.cn-beijing.aliyuncs.com
BACKEND_TAG=latest
FRONTEND_TAG=latest