# MSDS生产环境配置文件示例
# 使用说明：复制此文件为 .env.prod 并修改密码等敏感信息

# ====================
# 数据库配置
# ====================
MYSQL_ROOT_PASSWORD=msds_root_password_2024_CHANGE_ME
MYSQL_PASSWORD=msds_prod_password_2024_CHANGE_ME

# ====================
# Redis配置
# ====================
REDIS_PASSWORD=msds_redis_password_2024_CHANGE_ME

# ====================
# 应用配置
# ====================
SPRING_PROFILE=prod

# ====================
# 服务器配置
# ====================
SERVER_IP=39.107.211.72
DOMAIN_NAME=flymsds.cn

# ====================
# 端口配置
# ====================
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# ====================
# 时区配置
# ====================
TZ=Asia/Shanghai

# ====================
# JVM配置
# ====================
JAVA_OPTS=-Xms1024m -Xmx2048m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

