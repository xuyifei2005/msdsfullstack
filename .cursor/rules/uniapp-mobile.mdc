### 3. 状态管理 (Vuex)
```javascript
// store/modules/msds.js
export default {
  namespaced: true,
  
  state: {
    currentMsds: null,
    searchHistory: [],
    favoriteList: []
  },
  
  getters: {
    // 获取当前MSDS的化学品别名数组
    currentAliases: state => {
      return state.currentMsds?.aliases?.split(',').filter(Boolean) || [];
    }
  },
  
  mutations: {
    SET_CURRENT_MSDS(state, msds) {
      state.currentMsds = msds;
    },
    
    ADD_SEARCH_HISTORY(state, keyword) {
      if (!keyword || state.searchHistory.includes(keyword)) return;
      
      state.searchHistory.unshift(keyword);
      // 限制搜索历史最多10条
      if (state.searchHistory.length > 10) {
        state.searchHistory.pop();
      }
    },
    
    CLEAR_SEARCH_HISTORY(state) {
      state.searchHistory = [];
    }
  },
  
  actions: {
    // 设置当前MSDS
    setCurrentMsds({ commit }, msds) {
      commit('SET_CURRENT_MSDS', msds);
    },
    
    // 添加搜索历史
    addSearchHistory({ commit }, keyword) {
      commit('ADD_SEARCH_HISTORY', keyword);
    }
  }
}
```

### 4. 工具函数封装
```javascript
// utils/validate.js
export default {
  // 验证CAS号格式
  isValidCasNumber(cas) {
    const casRegex = /^\d{2,7}-\d{2}-\d$/;
    return casRegex.test(cas);
  },
  
  // 验证手机号格式
  isValidPhone(phone) {
    const phoneRegex = /^1[3-9]\d{9}$/;
    return phoneRegex.test(phone);
  },
  
  // 验证邮箱格式
  isValidEmail(email) {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return emailRegex.test(email);
  }
}

// utils/format.js
export default {
  // 格式化文件大小
  formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  },
  
  // 格式化日期时间
  formatDateTime(dateString) {
    if (!dateString) return '';
    const date = new Date(dateString);
    const Y = date.getFullYear();
    const M = (date.getMonth() + 1).toString().padStart(2, '0');
    const D = date.getDate().toString().padStart(2, '0');
    const h = date.getHours().toString().padStart(2, '0');
    const m = date.getMinutes().toString().padStart(2, '0');
    return `${Y}-${M}-${D} ${h}:${m}`;
  }
}
```

### 5. 文件上传组件
```vue
<template>
  <view class="upload-container">
    <u-upload
      :file-list="fileList"
      @afterRead="handleAfterRead"
      @delete="handleDelete"
      :max-count="maxCount"
      :accept="accept"
      :max-size="maxSize * 1024 * 1024"
      @oversize="handleOversize"
    >
      <view class="upload-btn" slot="addBtn">
        <u-icon name="plus" size="40" color="#c0c4cc" />
        <text class="upload-text">选择文件</text>
      </view>
    </u-upload>
  </view>
</template>

<script>
export default {
  name: 'MsdsUpload',
  
  props: {
    maxCount: {
      type: Number,
      default: 1
    },
    maxSize: {
      type: Number,
      default: 10 // MB
    },
    accept: {
      type: String,
      default: 'pdf,doc,docx'
    }
  },
  
  data() {
    return {
      fileList: []
    }
  },
  
  methods: {
    async handleAfterRead(event) {
      const { file } = event;
      
      // 文件类型验证
      if (!this.validateFileType(file.name)) {
        this.$u.toast('文件格式不支持');
        return;
      }
      
      // 添加到文件列表并显示上传状态
      const fileItem = {
        ...file,
        status: 'uploading',
        message: '上传中...'
      };
      
      this.fileList.push(fileItem);
      
      try {
        // 调用上传API
        const res = await this.$api.msds.uploadFile(file.url);
        
        // 更新文件状态
        fileItem.status = 'success';
        fileItem.message = '上传成功';
        fileItem.response = res.data;
        
        // 通知父组件上传成功
        this.$emit('success', res.data);
      } catch (error) {
        // 更新文件状态
        fileItem.status = 'error';
        fileItem.message = '上传失败';
        
        this.$u.toast('文件上传失败');
        console.error('文件上传失败:', error);
      }
    },
    
    validateFileType(fileName) {
      const extension = fileName.split('.').pop().toLowerCase();
      return this.accept.split(',').includes(extension);
    },
    
    handleDelete(event) {
      const { index } = event;
      this.fileList.splice(index, 1);
    },
    
    handleOversize() {
      this.$u.toast(`文件大小不能超过${this.maxSize}MB`);
    }
  }
}
</script>
```

