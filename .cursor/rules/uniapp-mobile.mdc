### 2. API接口封装（基于RuoYi-App）

#### 使用RuoYi的request模块
```javascript
// api/msds.js
import request from '@/utils/request'  // RuoYi封装的request模块

export default {
  // 获取MSDS列表（遵循RuoYi分页规范）
  getList(params) {
    return request({
      url: '/system/msds/list',
      method: 'GET',
      params  // pageNum, pageSize, chemicalName等参数
    })
  },
  
  // 获取MSDS详情
  getDetail(id) {
    return request({
      url: `/system/msds/${id}`,
      method: 'GET'
    })
  },
  
  // 新增MSDS（使用RuoYi的AjaxResult返回格式）
  add(data) {
    return request({
      url: '/system/msds',
      method: 'POST',
      data
    })
  },
  
  // 修改MSDS
  update(data) {
    return request({
      url: '/system/msds',
      method: 'PUT',
      data
    })
  },
  
  // 删除MSDS
  delete(ids) {
    return request({
      url: `/system/msds/${ids}`,
      method: 'DELETE'
    })
  },
  
  // 上传MSDS文件（RuoYi文件上传方式）
  uploadFile(filePath, formData = {}) {
    const uploadUrl = request.baseURL + '/system/msds/upload'
    const token = uni.getStorageSync('token')
    
    return new Promise((resolve, reject) => {
      uni.uploadFile({
        url: uploadUrl,
        filePath,
        name: 'file',
        formData,
        header: {
          'Authorization': 'Bearer ' + token
        },
        success: (res) => {
          const data = JSON.parse(res.data);
          // RuoYi标准返回格式：{code: 200, msg: 'success', data: {...}}
          if (data.code === 200) {
            resolve(data);
          } else {
            uni.showToast({
              title: data.msg || '上传失败',
              icon: 'none'
            });
            reject(data);
          }
        },
        fail: (err) => {
          uni.showToast({
            title: '网络错误',
            icon: 'none'
          });
          reject(err);
        }
      });
    });
  }
}
```

#### RuoYi的统一返回格式处理
```javascript
// utils/request.js 中的响应拦截器（RuoYi已封装）
// RuoYi后端统一返回格式
{
