### 7. 错误处理和用户反馈
```javascript
// utils/errorHandler.js
export default {
  // 统一错误处理
  handleError(error, context = '') {
    console.error(`${context}错误:`, error);
    
    let message = '操作失败，请稍后重试';
    
    if (error.response) {
      // HTTP错误
      const { status, data } = error.response;
      switch (status) {
        case 401:
          message = '登录已过期，请重新登录';
          // 跳转到登录页
          uni.reLaunch({ url: '/pages/login/login' });
          break;
        case 403:
          message = '没有权限执行此操作';
          break;
        case 500:
          message = data?.msg || '服务器内部错误';
          break;
        default:
          message = data?.msg || `网络错误(${status})`;
      }
    } else if (error.message) {
      message = error.message;
    }
    
    uni.showToast({
      title: message,
      icon: 'none',
      duration: 2000
    });
  }
}
```