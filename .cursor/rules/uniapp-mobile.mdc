}

// 在组件中使用
async loadData() {
  const res = await this.$api.msds.getList({
    pageNum: this.pageNum,
    pageSize: this.pageSize
  });
  
  if (res.code === 200) {
    this.msdsList = res.rows;
    this.total = res.total;
  }
}
