### 1. 单文件组件结构
```vue
<template>
  <view class="msds-list">
    <u-search 
      placeholder="请输入化学品名称" 
      v-model="searchText"
      @search="handleSearch"
      @clear="handleClear"
    />
    
    <view class="list-container">
      <u-list @scrolltolower="loadMore" :show-scrollbar="false">
        <u-list-item v-for="item in msdsList" :key="item.id">
          <msds-card 
            :data="item" 
            @click="handleItemClick"
            @edit="handleEdit"
          />
        </u-list-item>
      </u-list>
    </view>
    
    <u-loadmore 
      :status="loadStatus" 
      :load-text="loadText"
    />
  </view>
</template>

<script>
export default {
  name: 'MsdsList',
  components: {
    MsdsCard: () => import('@/components/MsdsCard.vue')
  },
  
  data() {
    return {
      searchText: '',
      msdsList: [],
      pageNum: 1,
      pageSize: 20,
      total: 0,
      loading: false,
      loadStatus: 'loadmore'
    }
  },
  
  computed: {
    loadText() {
      const textMap = {
        'loadmore': { loadmore: '点击加载更多' },
        'loading': { loading: '正在加载...' },
        'nomore': { nomore: '没有更多了' }
      };
      return textMap[this.loadStatus] || textMap.loadmore;
    }
  },
  
  onLoad() {
    this.loadData();
  },
  
  onPullDownRefresh() {
    this.refreshData();
  },
  
  methods: {
    // 数据加载方法
    async loadData() {
      if (this.loading) return;
      
      this.loading = true;
      try {
        const res = await this.$api.msds.getList({
          pageNum: this.pageNum,
          pageSize: this.pageSize,
          chemicalName: this.searchText
        });
        
        if (res.code === 200) {
          const newList = res.rows || [];
          this.msdsList = this.pageNum === 1 ? newList : [...this.msdsList, ...newList];
          this.total = res.total;
          
          // 更新加载状态
          this.loadStatus = newList.length < this.pageSize ? 'nomore' : 'loadmore';
        }
      } catch (error) {
        this.$u.toast('数据加载失败');
        console.error('MSDS数据加载失败:', error);
      } finally {
        this.loading = false;
        uni.stopPullDownRefresh();
      }
    }
  }
}
</script>

