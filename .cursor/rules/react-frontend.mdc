  dataSource: MsdsItem[];
  loading?: boolean;
  onEdit?: (record: MsdsItem) => void;
  onDelete?: (id: string) => void;
}

const MsdsTable: React.FC<MsdsTableProps> = ({ 
  dataSource, 
  loading = false, 
  onEdit, 
  onDelete 
}) => {
  // 组件逻辑
};

export default MsdsTable;
```

### 2. Hooks使用规范
```tsx
// 自定义Hooks命名以use开头
const useMsdsData = (params: SearchParams) => {
  const [data, setData] = useState<MsdsItem[]>([]);
  const [loading, setLoading] = useState(false);
  
  // 使用ahooks优化
  const { run: fetchData } = useRequest(getMsdsList, {
    manual: true,
    onSuccess: (result) => setData(result.rows),
    onFinally: () => setLoading(false)
  });
  
  return { data, loading, fetchData };
};
```

### 3. 状态管理
```tsx
// 使用useReducer管理复杂状态
interface MsdsState {
  list: MsdsItem[];
  total: number;
  loading: boolean;
  searchForm: SearchForm;
}

const msdsReducer = (state: MsdsState, action: MsdsAction): MsdsState => {
  switch (action.type) {
    case 'SET_LOADING':
      return { ...state, loading: action.payload };
    case 'SET_LIST':
      return { ...state, list: action.payload, loading: false };
    default:
      return state;
  }
};
```

### 4. 表单处理规范
```tsx
// 使用Ant Design Form + 自定义验证
const MsdsForm: React.FC<MsdsFormProps> = ({ initialValues, onSubmit }) => {
  const [form] = Form.useForm();
  
  const handleSubmit = async (values: MsdsFormData) => {
    try {
      // 数据预处理
      const processedValues = {
        ...values,
        aliases: values.aliases?.filter(Boolean).join(','),
        createTime: moment().format('YYYY-MM-DD HH:mm:ss')
      };
      
      await onSubmit(processedValues);
      message.success('保存成功');
      form.resetFields();
    } catch (error) {
      message.error(`保存失败：${error.message}`);
    }
  };

  return (
    <Form
      form={form}
      initialValues={initialValues}
      onFinish={handleSubmit}
      labelCol={{ span: 6 }}
      wrapperCol={{ span: 18 }}
    >
      {/* 表单项 */}
    </Form>
  );
};
```

### 5. 数据获取和API调用
```tsx
// API服务层封装
export const msdsApi = {
  // 获取MSDS列表
  getList: (params: MsdsQueryParams): Promise<ApiResponse<MsdsItem[]>> => {
    return request.get('/system/msds/list', { params });
  },
  
  // 上传MSDS文件
  uploadFile: (file: File, onProgress?: (percent: number) => void): Promise<UploadResponse> => {
    const formData = new FormData();
    formData.append('file', file);
    
    return request.post('/system/msds/upload', formData, {
      headers: { 'Content-Type': 'multipart/form-data' },
      onUploadProgress: (progressEvent) => {
        const percent = Math.round((progressEvent.loaded * 100) / progressEvent.total);
        onProgress?.(percent);
      }
    });
  }
};

// 在组件中使用
const { data, loading, error } = useRequest(msdsApi.getList, {
  defaultParams: [{ pageNum: 1, pageSize: 20 }],
  refreshDeps: [searchParams]
});
```

