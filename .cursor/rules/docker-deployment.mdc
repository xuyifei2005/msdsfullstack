### 3. Dockerfile最佳实践

#### Java后端Dockerfile
```dockerfile
# 多阶段构建优化镜像大小
FROM maven:3.8-openjdk-11 AS builder

WORKDIR /app
# 先复制pom.xml文件，利用Docker缓存优化依赖下载
COPY pom.xml .
COPY ruoyi-*/pom.xml ruoyi-*/
RUN mvn dependency:go-offline -B

# 复制源码并构建
COPY . .
RUN mvn clean package -DskipTests -B

# 运行时镜像
FROM openjdk:11-jre-slim

# 创建非root用户提升安全性
RUN groupadd -r msds && useradd -r -g msds msds

WORKDIR /app

# 安装必要工具和字体支持（处理PDF中文）
RUN apt-get update && apt-get install -y \
    curl \
    fontconfig \
    fonts-wqy-microhei \
    && rm -rf /var/lib/apt/lists/*

# 复制构建产物
COPY --from=builder /app/ruoyi-admin/target/ruoyi-admin.jar app.jar

# 创建必要目录
RUN mkdir -p /app/logs /app/upload && \
    chown -R msds:msds /app

# 切换到非root用户
USER msds

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

# JVM优化参数
ENV JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC -XX:+PrintGCDetails -Djava.security.egd=file:/dev/./urandom"

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS $JVM_OPTS -jar app.jar"]
```

#### 前端构建Dockerfile
```dockerfile
FROM node:16-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

COPY . .
RUN npm run build

# Nginx运行时
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制nginx配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 创建日志目录
RUN mkdir -p /var/log/nginx && \
    chown -R nginx:nginx /var/log/nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
```

### 4. 部署脚本规范

#### 部署脚本 (deploy.sh)
```bash
#!/bin/bash

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 日志函数
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# 检查Docker和Docker Compose
check_requirements() {
    if ! command -v docker &> /dev/null; then
        log_error "Docker未安装，请先安装Docker"
        exit 1
    fi
    
    if ! command -v docker-compose &> /dev/null; then
        log_error "Docker Compose未安装，请先安装Docker Compose"
        exit 1
    fi
    
    log_info "环境检查通过"
}

# 备份数据库
backup_database() {
    local timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_file="backup/mysql_backup_${timestamp}.sql"
    
    log_info "开始备份数据库..."
    
    mkdir -p backup
    
    docker-compose exec -T mysql mysqldump \
        -u${MYSQL_USER:-msds} \
        -p${MYSQL_PASSWORD:-msds123456} \
        ${MYSQL_DATABASE:-ry_msds} > ${backup_file}
    
    if [ $? -eq 0 ]; then
        log_info "数据库备份完成: ${backup_file}"
        
        # 删除7天前的备份
        find backup -name "mysql_backup_*.sql" -mtime +7 -delete
    else
        log_error "数据库备份失败"
        exit 1
    fi
}

# 部署应用
deploy() {
    local environment=${1:-prod}
    
    log_info "开始部署MSDS系统到 ${environment} 环境..."
    
    # 检查配置文件
    if [ ! -f ".env" ]; then
        log_warn ".env文件不存在，使用默认配置"
        cp .env.example .env
    fi
    
    # 拉取最新镜像
    log_info "拉取最新镜像..."
    docker-compose pull
    
    # 备份数据库（生产环境）
    if [ "$environment" = "prod" ]; then
        backup_database
    fi
    
    # 停止旧容器
    log_info "停止旧容器..."
    docker-compose down --remove-orphans
    
    # 构建并启动新容器
    log_info "构建并启动容器..."
    docker-compose up -d --build
    
    # 等待服务启动
    log_info "等待服务启动..."
    sleep 30
    
    # 健康检查
    check_health
    
    log_info "部署完成！"
}

# 健康检查
check_health() {
    local max_retries=10
    local retry=0
    
    while [ $retry -lt $max_retries ]; do
        if docker-compose exec -T backend curl -f http://localhost:8080/actuator/health > /dev/null 2>&1; then
            log_info "后端服务健康检查通过"
            break
        fi
        
        retry=$((retry + 1))
        log_warn "健康检查失败，重试 $retry/$max_retries..."
        sleep 10
    done
    
    if [ $retry -eq $max_retries ]; then
        log_error "后端服务健康检查失败"
        docker-compose logs backend
        exit 1
    fi
}

# 回滚功能
rollback() {
    local backup_file=$1
    
    if [ -z "$backup_file" ]; then
        log_error "请指定备份文件"
        exit 1
    fi
    
    if [ ! -f "$backup_file" ]; then
        log_error "备份文件不存在: $backup_file"
        exit 1
    fi
    
    log_warn "开始回滚数据库..."
    
    docker-compose exec -T mysql mysql \
        -u${MYSQL_USER:-msds} \
        -p${MYSQL_PASSWORD:-msds123456} \
        ${MYSQL_DATABASE:-ry_msds} < $backup_file
    
    if [ $? -eq 0 ]; then
        log_info "数据库回滚完成"
        docker-compose restart backend
    else
        log_error "数据库回滚失败"
        exit 1
    fi
}

# 清理资源
cleanup() {
    log_info "清理未使用的Docker资源..."
    
    docker system prune -f
    docker volume prune -f
    docker image prune -f
    
    log_info "清理完成"
}

# 主函数
main() {
    case "$1" in
        "deploy")
            check_requirements
            deploy $2
            ;;
        "backup")
            backup_database
            ;;
        "rollback")
            rollback $2
            ;;
        "health")
            check_health
            ;;
        "cleanup")
            cleanup
            ;;
        *)
            echo "使用方法: $0 {deploy|backup|rollback|health|cleanup} [参数]"
            echo ""
            echo "命令说明:"
            echo "  deploy [env]     - 部署应用 (env: dev|test|prod, 默认prod)"
            echo "  backup          - 备份数据库"
            echo "  rollback <file> - 回滚数据库到指定备份"
            echo "  health          - 健康检查"
            echo "  cleanup         - 清理Docker资源"
            exit 1
            ;;
    esac
}

main "$@"
```

### 5. 监控和日志配置

#### 日志轮转配置 (logrotate.conf)
```bash
/var/log/nginx/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 0640 nginx nginx
    postrotate
        docker-compose exec nginx nginx -s reload
    endscript
}

/app/logs/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    copytruncate
}
```

#### 监控脚本 (monitor.sh)
```bash
#!/bin/bash

# 服务健康监控
check_services() {
    services=("mysql" "backend" "nginx")
    
    for service in "${services[@]}"; do
        if ! docker-compose ps $service | grep "Up" > /dev/null; then
            echo "ALERT: $service 服务异常"
            # 发送告警通知
            send_alert "$service 服务异常，请及时处理"
        fi
    done
}

# 资源监控
check_resources() {
    # 检查磁盘使用率
    disk_usage=$(df / | tail -1 | awk '{print $5}' | sed 's/%//')
    if [ $disk_usage -gt 80 ]; then
        send_alert "磁盘使用率过高: ${disk_usage}%"
    fi
    
    # 检查内存使用率
    mem_usage=$(free | grep Mem | awk '{printf "%.0f", $3/$2 * 100.0}')
    if [ $mem_usage -gt 80 ]; then
        send_alert "内存使用率过高: ${mem_usage}%"
    fi
}

# 发送告警
send_alert() {
    local message=$1
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    echo "[$timestamp] $message" >> /var/log/msds-monitor.log
    
    # 可以集成钉钉、邮件等告警方式
    # curl -X POST "钉钉机器人URL" -H "Content-Type: application/json" -d "{\"msgtype\": \"text\", \"text\": {\"content\": \"$message\"}}"
}

# 定时执行监控
while true; do
    check_services
    check_resources
    sleep 300  # 5分钟检查一次
done
```

## CI/CD自动化部署

### GitHub Actions工作流配置

本项目使用GitHub Actions进行自动化构建和部署，配置文件位于 `.github/workflows/deploy.yml`。

#### 工作流触发条件
```yaml
on:
  push:
    branches:
      - main
      - develop
  pull_request:
    branches:
      - main
      - develop
```

#### 关键步骤

1. **前端构建**
   - 在Docker容器中编译React应用
   - 缓存npm依赖以提升构建速度
   - 生成生产环境静态文件

2. **后端构建**
   - 在Docker容器中编译Spring Boot应用
   - 使用Maven缓存依赖
   - 打包为可执行JAR文件

3. **Docker镜像构建与推送**
   - 构建前端和后端Docker镜像
   - 推送到阿里云容器镜像仓库
   - 使用Git SHA作为镜像标签

#### 重要配置项

**必需的GitHub Secrets**：
```bash
ALIYUN_REGISTRY_USERNAME    # 阿里云容器镜像服务用户名
ALIYUN_REGISTRY_PASSWORD    # 阿里云容器镜像服务固定密码
```

**环境变量**：
```yaml
env:
  REGISTRY: registry.cn-beijing.aliyuncs.com  # 阿里云镜像仓库地址
  NAMESPACE: jfkjmsds                          # 命名空间
  BACKEND_IMAGE: backend                       # 后端镜像名
  FRONTEND_IMAGE: frontend                     # 前端镜像名
```

### 阿里云容器镜像服务配置

#### 服务信息
- **服务类型**: 个人实例版（免费）
- **区域**: 华北2（北京）`registry.cn-beijing.aliyuncs.com`
- **命名空间**: `jfkjmsds`
- **镜像仓库**: 
  - `backend` - Java Spring Boot后端服务
  - `frontend` - React前端应用

#### 配置步骤

1. **获取访问凭证**
   - 登录 https://cr.console.aliyun.com/
   - 点击右上角"访问凭证"
   - 设置固定密码（用于Docker登录）

2. **配置GitHub Secrets**
   - 访问 GitHub仓库 → Settings → Secrets and variables → Actions
   - 添加 `ALIYUN_REGISTRY_USERNAME`（阿里云账号或用户名）
   - 添加 `ALIYUN_REGISTRY_PASSWORD`（固定密码）

3. **本地测试登录**
   ```bash
   # 测试阿里云镜像仓库登录
   docker login registry.cn-beijing.aliyuncs.com
   # 输入用户名和固定密码
   ```

#### 镜像命名规范
```
registry.cn-beijing.aliyuncs.com/jfkjmsds/backend:v1.0.0
registry.cn-beijing.aliyuncs.com/jfkjmsds/frontend:v1.0.0
```

### CI/CD最佳实践

#### 1. 构建优化
- ✅ 使用多阶段构建减小镜像体积
- ✅ 缓存依赖层提升构建速度
- ✅ 只在main/develop分支推送镜像

#### 2. 安全管理
- ⚠️ **永远不要在代码中硬编码凭证**
- ✅ 使用GitHub Secrets管理敏感信息
- ✅ 定期轮换访问密码
- ✅ 镜像仓库设置为私有

#### 3. 版本管理
- 使用Git SHA作为镜像标签确保可追溯
- 重要版本使用语义化版本号（v1.0.0）
- 保留最近N个镜像版本，定期清理旧版本

#### 4. 监控与日志
- 关注GitHub Actions构建日志
- 监控Docker镜像推送状态
- 设置构建失败告警通知

### 常见问题排查

#### 问题1：package-lock.json未找到
**错误**: `Some specified paths were not resolved, unable to cache dependencies`

**解决方案**: 确保`package-lock.json`已提交到Git仓库，不要在`.gitignore`中排除它。

#### 问题2：Docker登录失败 (403 Forbidden)
**错误**: `login attempt to https://registry.cn-beijing.aliyuncs.com/v2/ failed with status: 403 Forbidden`

**解决方案**: 
- 检查GitHub Secrets中的用户名和密码是否正确
- 确认使用的是"固定密码"而非阿里云登录密码
- 验证用户名格式（可能是邮箱、账号ID或其他格式）

#### 问题3：unauthorized错误
**错误**: `unauthorized: authentication required`

**解决方案**:
- GitHub Secrets未配置或配置错误
- 重新从阿里云"访问凭证"页面获取正确的用户名
- 确认固定密码已设置并使用正确

#### 问题4：命名空间不存在
**错误**: 推送镜像时提示命名空间不存在

**解决方案**:
- 在阿里云容器镜像服务中创建命名空间
- 确保工作流中的`NAMESPACE`环境变量与实际创建的一致

### 部署流程图

```
开发 → 提交代码 → Push到GitHub
  ↓
GitHub Actions触发
  ↓
1. 检出代码
2. 设置Node.js/Java环境
3. 构建前端/后端应用
  ↓
4. 构建Docker镜像
  ↓
5. 登录阿里云容器镜像仓库
  ↓
6. 推送镜像
  ↓
7. 部署到生产环境（可选）
```

### 手动部署命令

如果需要手动构建和推送镜像：

```bash
# 1. 登录阿里云镜像仓库
docker login registry.cn-beijing.aliyuncs.com

# 2. 构建镜像
docker build -t registry.cn-beijing.aliyuncs.com/jfkjmsds/backend:latest ./msdsPC/ruoyi-MsdsPc-react
docker build -t registry.cn-beijing.aliyuncs.com/jfkjmsds/frontend:latest ./msdsPC/ruoyi-MsdsPc-react/react-ui

# 3. 推送镜像
docker push registry.cn-beijing.aliyuncs.com/jfkjmsds/backend:latest
docker push registry.cn-beijing.aliyuncs.com/jfkjmsds/frontend:latest

# 4. 在服务器上拉取并运行
docker pull registry.cn-beijing.aliyuncs.com/jfkjmsds/backend:latest
docker-compose up -d
```