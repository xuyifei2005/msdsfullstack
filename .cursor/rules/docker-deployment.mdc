### 3. Dockerfile最佳实践

#### Java后端Dockerfile
```dockerfile
# 多阶段构建优化镜像大小
FROM maven:3.8-openjdk-11 AS builder

WORKDIR /app
# 先复制pom.xml文件，利用Docker缓存优化依赖下载
COPY pom.xml .
COPY ruoyi-*/pom.xml ruoyi-*/
RUN mvn dependency:go-offline -B

# 复制源码并构建
COPY . .
RUN mvn clean package -DskipTests -B

# 运行时镜像
FROM openjdk:11-jre-slim

# 创建非root用户提升安全性
RUN groupadd -r msds && useradd -r -g msds msds

WORKDIR /app

# 安装必要工具和字体支持（处理PDF中文）
RUN apt-get update && apt-get install -y \
    curl \
    fontconfig \
    fonts-wqy-microhei \
    && rm -rf /var/lib/apt/lists/*

# 复制构建产物
COPY --from=builder /app/ruoyi-admin/target/ruoyi-admin.jar app.jar

# 创建必要目录
RUN mkdir -p /app/logs /app/upload && \
    chown -R msds:msds /app

# 切换到非root用户
USER msds

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

# JVM优化参数
ENV JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC -XX:+PrintGCDetails -Djava.security.egd=file:/dev/./urandom"

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS $JVM_OPTS -jar app.jar"]
```

#### 前端构建Dockerfile
```dockerfile
FROM node:16-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

COPY . .
RUN npm run build

# Nginx运行时
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制nginx配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 创建日志目录
RUN mkdir -p /var/log/nginx && \
    chown -R nginx:nginx /var/log/nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
```

### 4. 部署脚本规范

#### 部署脚本 (deploy.sh)
```bash
#!/bin/bash

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 日志函数
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# 检查Docker和Docker Compose
check_requirements() {
    if ! command -v docker &> /dev/null; then
        log_error "Docker未安装，请先安装Docker"
        exit 1
    fi
    
    if ! command -v docker-compose &> /dev/null; then
        log_error "Docker Compose未安装，请先安装Docker Compose"
        exit 1
    fi
    
    log_info "环境检查通过"
}

# 备份数据库
backup_database() {
    local timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_file="backup/mysql_backup_${timestamp}.sql"
    
    log_info "开始备份数据库..."
    
    mkdir -p backup
    
    docker-compose exec -T mysql mysqldump \
        -u${MYSQL_USER:-msds} \
        -p${MYSQL_PASSWORD:-msds123456} \
        ${MYSQL_DATABASE:-ry_msds} > ${backup_file}
    
    if [ $? -eq 0 ]; then
        log_info "数据库备份完成: ${backup_file}"
        
        # 删除7天前的备份
        find backup -name "mysql_backup_*.sql" -mtime +7 -delete
    else
        log_error "数据库备份失败"
        exit 1
    fi
}

# 部署应用
deploy() {
    local environment=${1:-prod}
    
    log_info "开始部署MSDS系统到 ${environment} 环境..."
    
    # 检查配置文件
    if [ ! -f ".env" ]; then
        log_warn ".env文件不存在，使用默认配置"
        cp .env.example .env
    fi
    
    # 拉取最新镜像
    log_info "拉取最新镜像..."
    docker-compose pull
    
    # 备份数据库（生产环境）
    if [ "$environment" = "prod" ]; then
        backup_database
    fi
    
    # 停止旧容器
    log_info "停止旧容器..."
    docker-compose down --remove-orphans
    
    # 构建并启动新容器
    log_info "构建并启动容器..."
    docker-compose up -d --build
    
    # 等待服务启动
    log_info "等待服务启动..."
    sleep 30
    
    # 健康检查
    check_health
    
    log_info "部署完成！"
}

# 健康检查
check_health() {
    local max_retries=10
    local retry=0
    
    while [ $retry -lt $max_retries ]; do
        if docker-compose exec -T backend curl -f http://localhost:8080/actuator/health > /dev/null 2>&1; then
            log_info "后端服务健康检查通过"
            break
        fi
        
        retry=$((retry + 1))
        log_warn "健康检查失败，重试 $retry/$max_retries..."
        sleep 10
    done
    
    if [ $retry -eq $max_retries ]; then
        log_error "后端服务健康检查失败"
        docker-compose logs backend
        exit 1
    fi
}

# 回滚功能
rollback() {
    local backup_file=$1
    
    if [ -z "$backup_file" ]; then
        log_error "请指定备份文件"
        exit 1
    fi
    
    if [ ! -f "$backup_file" ]; then
        log_error "备份文件不存在: $backup_file"
        exit 1
    fi
    
    log_warn "开始回滚数据库..."
    
    docker-compose exec -T mysql mysql \
        -u${MYSQL_USER:-msds} \
        -p${MYSQL_PASSWORD:-msds123456} \
        ${MYSQL_DATABASE:-ry_msds} < $backup_file
    
    if [ $? -eq 0 ]; then
        log_info "数据库回滚完成"
        docker-compose restart backend
    else
        log_error "数据库回滚失败"
        exit 1
    fi
}

# 清理资源
cleanup() {
    log_info "清理未使用的Docker资源..."
    
    docker system prune -f
    docker volume prune -f
    docker image prune -f
    
    log_info "清理完成"
}

# 主函数
main() {
    case "$1" in
        "deploy")
            check_requirements
            deploy $2
            ;;
        "backup")
            backup_database
            ;;
        "rollback")
            rollback $2
            ;;
        "health")
            check_health
            ;;
        "cleanup")
            cleanup
            ;;
        *)
            echo "使用方法: $0 {deploy|backup|rollback|health|cleanup} [参数]"
            echo ""
            echo "命令说明:"
            echo "  deploy [env]     - 部署应用 (env: dev|test|prod, 默认prod)"
            echo "  backup          - 备份数据库"
            echo "  rollback <file> - 回滚数据库到指定备份"
            echo "  health          - 健康检查"
            echo "  cleanup         - 清理Docker资源"
            exit 1
            ;;
    esac
}

main "$@"
```

### 5. 监控和日志配置

#### 日志轮转配置 (logrotate.conf)
```bash
/var/log/nginx/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 0640 nginx nginx
    postrotate
        docker-compose exec nginx nginx -s reload
    endscript
}

/app/logs/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    copytruncate
}
```

#### 监控脚本 (monitor.sh)
```bash
#!/bin/bash

# 服务健康监控
check_services() {
    services=("mysql" "backend" "nginx")
    
    for service in "${services[@]}"; do
        if ! docker-compose ps $service | grep "Up" > /dev/null; then
            echo "ALERT: $service 服务异常"
            # 发送告警通知
            send_alert "$service 服务异常，请及时处理"
        fi
    done
}

# 资源监控
check_resources() {
    # 检查磁盘使用率
    disk_usage=$(df / | tail -1 | awk '{print $5}' | sed 's/%//')
    if [ $disk_usage -gt 80 ]; then
        send_alert "磁盘使用率过高: ${disk_usage}%"
    fi
    
    # 检查内存使用率
    mem_usage=$(free | grep Mem | awk '{printf "%.0f", $3/$2 * 100.0}')
    if [ $mem_usage -gt 80 ]; then
        send_alert "内存使用率过高: ${mem_usage}%"
    fi
}

# 发送告警
send_alert() {
    local message=$1
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    echo "[$timestamp] $message" >> /var/log/msds-monitor.log
    
    # 可以集成钉钉、邮件等告警方式
    # curl -X POST "钉钉机器人URL" -H "Content-Type: application/json" -d "{\"msgtype\": \"text\", \"text\": {\"content\": \"$message\"}}"
}

# 定时执行监控
while true; do
    check_services
    check_resources
    sleep 300  # 5分钟检查一次
done
```