><view>正确答案：</view><view>{{item.questionAnswer}}</view></view><view class="f12 co29354D mt20 flex"><view class="w60 mt5s">解析：</view><view class="lin25 w70">{{item.analysis}}</view></view></view></view></swiper-item></block><block wx:for="{{judgmentPaperList}}" wx:for-item="item" wx:for-index="index"><swiper-item class="swiper-item"><view class="w100 pt15 boxs"><view class="flexenters w100"><view class="bg3476F7 w50s p3 boxs colorfff f12 bor6 flexCenter juCen">判断</view><view class="album">{{''+(index+1+$root.g1+$root.g2)+"/"+total+''}}</view></view><view class="w100 mt10"><view class="name">{{item.problem}}</view><block wx:for="{{item.options}}" wx:for-item="items" wx:for-index="indexs" wx:key="indexs"><view class="f12 boxst p10 boxs mt15 bor6"><view class="viewst">{{items.value}}</view></view></block></view><view class="w100"><view class="f12 co29354D mt20 flex"><view>我的答案：</view><view class="{{[item.isCorrect==0?'co39D2A9':'coF05C3F']}}">{{item.resource}}</view></view><view class="f12 co29354D mt20 flex"><view>正确答案：</view><view>{{item.questionAnswer}}</view></view><view class="f12 co29354D mt20 flex"><view class="w60 mt5s">解析：</view><view class="lin25 w70">{{item.analysis}}</view></view></view></view></swiper-item></block></swiper></view>