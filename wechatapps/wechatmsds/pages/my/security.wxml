<view class="w100"><view class="w100 boxs bg0081FF pt15 pl15 pr15 pb30"><view class="w100 flexenters"><block wx:for="{{list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['navCurrentInd',[index]]]]]}}" class="{{['w50','juCen','por','f16',indexs==index?'colorfff navCurrentCla':'colorfff opacitys']}}" bindtap="__e">{{item.name}}</view></block></view></view><block wx:if="{{indexs==0}}"><view class="w100 mt60 p30 boxs f14"><view class="w100 flexenters pb15 pt15 boxs borb"><view class="w60">原密码：</view><input class="w60s f12" type="text" placeholder="请输入原密码" placeholder-class="f12" data-event-opts="{{[['input',[['__set_model',['','password','$event',[]]]]]]}}" value="{{password}}" bindinput="__e"/></view><view class="w100 flexenters pb15 pt15 boxs borb"><view class="w60">新密码：</view><input class="w60s f12" type="text" placeholder="请输入新密码" placeholder-class="f12" data-event-opts="{{[['input',[['__set_model',['','newPassWord','$event',[]]]]]]}}" value="{{newPassWord}}" bindinput="__e"/></view><view class="w100 flexenters pb15 pt15 boxs borb"><view class="w60">确认密码：</view><input class="w60s f12" type="text" placeholder="再次填写确认" placeholder-class="f12" data-event-opts="{{[['input',[['__set_model',['','secondPassword','$event',[]]]]]]}}" value="{{secondPassword}}" bindinput="__e"/></view></view></block><block wx:if="{{indexs==1}}"><view class="w100 mt60 p30 boxs f14"><view class="w100 flexenters pb15 pt15 boxs borb"><view class="w60">新手机号：</view><input class="w60s f12" type="text" placeholder="请输入新手机号" placeholder-class="f12" data-event-opts="{{[['input',[['__set_model',['','phone','$event',[]]]]]]}}" value="{{phone}}" bindinput="__e"/></view><view class="w100 flexenters pb15 pt15 boxs borb"><view class="w60">验证码：</view><view class="w60s f12 flexenters"><input class="w40" type="text" placeholder="请输入验证码" placeholder-class="f12" data-event-opts="{{[['input',[['__set_model',['','codes','$event',[]]]]]]}}" value="{{codes}}" bindinput="