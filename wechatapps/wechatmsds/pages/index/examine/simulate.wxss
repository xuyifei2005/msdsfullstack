.radiot {
	width: 100%;
	display: block;
	padding: 30rpx 0;
	box-sizing: border-box;
	margin-top: 30rpx;
	border-radius: 8rpx;
	color: #000;
	font-size: 28rpx;
	position: relative;
}
.viewst {
	width: 100%;
	padding: 0 30rpx;
	box-sizing: border-box;
}
.radiot .uni-radio-input-disabled {
	background: unset !important;
}
.radiot .uni-radio-input {
	position: absolute;
	border-radius: 8rpx;
	height: 100%;
	width: 100%;
	background: unset;
}
.radiot .uni-radio-input.uni-radio-input-checked {
	border-radius: 15rpx;
	position: absolute;
	height: 100%;
	width: 100%;
	border: 1px solid #353EA3 !important;
	background: unset !important;
}
radio .uni-radio-input.uni-radio-input-checked::before {

	text-align: center;
	color: transparent;
	background: unset !important;
}
.checkbox {
	width: 100%;
	display: block;
	padding: 30rpx 0;
	border: 1px solid #e7e7e7;
	box-sizing: border-box;
	margin-top: 30rpx;
	border-radius: 8rpx;
	color: #000;
	font-size: 28rpx;
	position: relative;
}
.checkbox .uni-checkbox-input {
	position: absolute;
	border-radius: 8rpx;
	height: 100%;
	width: 100%;
	background: unset;
}

/* 选中后的样式 （可根据设计稿需求自己修改） */
.checkbox .uni-checkbox-input.uni-checkbox-input-checked {
	border-radius: 15rpx;
	position: absolute;
	height: 100%;
	width: 100%;
	border: 1px solid #353EA3 !important;
	background: unset !important;
}
.checkbox .uni-checkbox-input.uni-checkbox-input-checked::before {
	text-align: center;
	color: transparent;
	/* 对勾颜色 白色 */
	background: unset !important;
}
.checkbox .uni-checkbox-input-disabled {
	background: unset !important;
}
