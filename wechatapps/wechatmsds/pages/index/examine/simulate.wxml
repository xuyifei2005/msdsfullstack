<view class="w100 h100"><view class="w100"><view class="flexenters w100 p15 boxs f12"><view>总分:100</view><view>{{"时间:"+durations+"分钟"}}</view><view>{{"剩余时间:"+countdown}}</view></view></view><view class="w100 p15 boxs mybox"><swiper class="swiper" current="{{sindex}}" duration="100" data-event-opts="{{[['change',[['change',['$event']]]]]}}" bindchange="__e"><block wx:for="{{radioPaperList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><swiper-item class="swiper-item"><view class="w100"><view class="flexenters w100"><view class="bg3476F7 p3 boxs colorfff f12 bor6">单选</view><view class="album">{{index+1+"/"+total}}</view></view><view class="name mt15">{{item.problem}}</view><radio-group class="radio-group w100" data-id="{{item.ldqId}}" data-event-opts="{{[['change',[['single',['$event']]]]]}}" bindchange="__e"><block wx:for="{{item.options}}" wx:for-item="items" wx:for-index="indexs" wx:key="indexs"><radio class="radiot w100" value="{{items.key}}"><view class="viewst">{{items.key+"："+items.value}}</view></radio></block></radio-group><view class="juCen flexCenter put"><block wx:if="{{index!=0}}"><view data-event-opts="{{[['tap',[['up',['$event']]]]]}}" class="puts" bindtap="__e">上一题</view></block><view data-event-opts="{{[['tap',[['ups',['$event']]]]]}}" class="puts ml10" bindtap="__e">下一题</view></view></view></swiper-item></block><block wx:for="{{checkboxPaperList}}" wx:for-item="item" wx:for-index="index"><swiper-item class="swiper-item"><view class="w100"><view class="flexenters w100"><view class="bg3476F7 p3 boxs colorfff f12 bor6">多选</view><view class="album">{{index+1+$root.g0+"/"+total}}</view></view><view class="name mt15">{{item.problem}}</view><block wx:for="{{item.options}}" wx:for-item="items" wx:for-index="indexs" wx:key="indexs"><block><checkbox-group data-id="{{item.ldqId}}" data-index="{{index}}" data-indexs="{{indexs}}" data-event-opts="{{[['change',[['multiple',['$event']]]]]}}" bindchange="__e"><label class="checkbox"><checkbox value="{{items.key}}"><view class="viewst">{{items.key+"："+items.value}}</view></checkbox></label></checkbox-group></block></block><view class="juCen flexCenter put"><view data-event-opts="{{[['tap',[['up',['$event']]]]]}}" class="puts" bindtap="__e">上一题</view><view data-event-opts="{{[['tap',[['ups',['$event']]]]]}}" class="puts ml10" bindtap="__e">下一题</view></view></view></swiper-item></block><block wx:for="{{judgmentPaperList}}" wx:for-item="item" wx:for-index="index"><swiper-item class="swiper-item"><view class="w100"><view class="flexenters w100"><view class="bg3476F7 p3 boxs colorfff f12 bor6">判断</view><view class="album">{{''+(index+1+$root.g1+$root.g2)+"/"+total+''}}</view></view><view class="name">{{item.problem}}</view><radio-group class="radio-group" data-id="{{item.ldqId}}" data-event-opts="{{[['change',[['judge',['$event']]]]]}}" bindchange="__e"><block wx:for="{{item.options}}" wx:for-item="items" wx:for-index="indexs" wx:key="indexs"><radio class="radiot w100" value="{{items.value}}"><view class="viewst">{{items.value}}</view></radio></block></radio-group><view class="juCen flexCenter put"><view data-event-opts="{{[['tap',[['up',['$event']]]]]}}" class="puts" bindtap="__e">上一题</view><block wx:if="{{index+1+$root.g3+$root.g4!=total}}"><view data-event-opts="{{[['tap',[['ups',['$event']]]]]}}" class="puts ml10" bindtap="__e">下一题</view></block></view></view></swiper-item></block></swiper></view><view data-event-opts="{{[['tap',[['paper',['$event']]]]]}}" class="reset" bindtap="__e"><text>交卷</text></view></view>