{
  "name": "msds-management-system",
  "version": "1.0.0",
  "description": "MSDS管理文件系统 - 专为实验室科研机构设计的化学品安全技术说明书电子化管理PC端应用",
  "author": "MSDS Team",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "workspaces": [
    "src/client",
    "src/server",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd src/client && npm run dev",
    "dev:server": "cd src/server && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:client": "cd src/client && npm run build",
    "build:server": "cd src/server && npm run build",
    "start": "npm run start:server",
    "start:server": "cd src/server && npm run start",
    "test": "npm run test:client && npm run test:server",
    "test:client": "cd src/client && npm run test",
    "test:server": "cd src/server && npm run test",
    "lint": "npm run lint:client && npm run lint:server",
    "lint:client": "cd src/client && npm run lint",
    "lint:server": "cd src/server && npm run lint",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose down",
    "setup": "npm install && npm run setup:client && npm run setup:server",
    "setup:client": "cd src/client && npm install",
    "setup:server": "cd src/server && npm install",
    "clean": "rimraf node_modules src/*/node_modules src/*/dist",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "msds",
    "chemical-safety",
    "laboratory",
    "document-management",
    "electron",
    "react",
    "fastify",
    "postgresql"
  ]
} 