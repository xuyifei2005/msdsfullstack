    <!-- 第四部分：急救措施 -->
    <first_aid>
      <skin_contact>脱去污染的衣着，用流动清水冲洗。</skin_contact>
      <eye_contact>立即翻开上下眼睑，用流动清水冲洗15分钟。</eye_contact>
      <inhalation>脱离现场至空气新鲜处。呼吸困难时给输氧。呼吸停止时，立即进行人工呼吸。就医。</inhalation>
      <ingestion>误服者给饮足量温水，催吐，就医。</ingestion>
    </first_aid>
    <!-- 第五部分：消防措施 -->
    <fire_fighting>
      <hazard_characteristics>放热现象，引起容器破裂和爆炸事故。</hazard_characteristics>
      <fire_risk_classification>丙</fire_risk_classification>
      <harmful_combustion_products>一氧化碳、二氧化碳。</harmful_combustion_products>
      <suitable_extinguishing_media>雾状水、二氧化碳、泡沫、干粉、砂土。</suitable_extinguishing_media>
    </fire_fighting>
    <!-- 第六部分：泄漏应急处理 -->
    <leak_response>
      <emergency_procedures>切断火源。戴自给式呼吸器，穿化学防护服。不要直接接触泄漏物，在确保安全情况下堵漏，利用围堤收容，撒湿冰或冰水冷却，然后收集、转移、回收或无害处理后废弃。</emergency_procedures>
      <containment_methods>使用惰性材料（如砂土、蛭石）围堵泄漏物，防止扩散。</containment_methods>
      <cleanup_methods>用不燃性分散剂制成乳液刷洗，如无分散剂可用砂土吸收。收集至密闭容器中待处理。</cleanup_methods>
      <environmental_precautions>防止进入下水道、地表水和地下水。避免对环境造成污染。</environmental_precautions>
    </leak_response>
    <!-- 第七部分：操作处置与储存 -->
    <handling_storage>
      <handling_precautions>密闭操作，提供充分的局部排风。防止蒸气泄漏到工作场所空气中。操作人员必须经过专门培训，严格遵守操作规程。建议操作人员佩戴自吸过滤式防毒面具（半面罩），戴化学安全防护眼镜，穿防静电工作服，戴橡胶耐油手套。远离火种、热源，工作场所严禁吸烟。使用防爆型的通风系统和设备。</handling_precautions>
      <storage_conditions>商品加有阻聚剂。储存于阴凉、通风仓间内。远离火种、热源。仓温不宜超过30℃。保持容器密封。应与氧化剂、酸类、碱类分开存放。搬运时要轻装轻卸，防止包装及容器损坏。</storage_conditions>
      <packaging_precautions>密封包装，储存于阴凉通风处，远离热源和氧化剂。</packaging_precautions>
    </handling_storage>
