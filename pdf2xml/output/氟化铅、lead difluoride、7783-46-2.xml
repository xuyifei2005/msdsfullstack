      <body_protection>穿透气型防毒服。</body_protection>
      <hand_protection>戴乳胶手套。</hand_protection>
      <other_protection>工作现场禁止吸烟、进食和饮水。工作完毕，淋浴更衣。实行就业前和定期的体检。单独</other_protection>
    </exposure_control>
