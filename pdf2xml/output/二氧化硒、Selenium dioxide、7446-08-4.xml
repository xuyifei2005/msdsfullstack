    <!-- 第四部分：急救措施 -->
    <first_aid>
      <skin_contact>脱去污染的衣着，立即用水冲洗至少15分钟。若有灼伤，就医治疗。</skin_contact>
      <eye_contact>立即提起眼睑，用流动清水或生理盐水冲洗至少15分钟。就医。</eye_contact>
      <inhalation>迅速脱离现场至空气新鲜处。注意保暖，保持呼吸道通畅。必要时进行人工呼吸。就医。</inhalation>
      <ingestion>误服者立即漱口，给饮大量温水，催吐，就医。</ingestion>
    </first_aid>
    <!-- 第五部分：消防措施 -->
    <fire_fighting>
      <hazard_characteristics>本身不能燃烧。若遇高热，升华产生剧毒的气体。</hazard_characteristics>
