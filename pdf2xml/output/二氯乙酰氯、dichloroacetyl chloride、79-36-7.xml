    <!-- 第四部分：急救措施 -->
    <first_aid>
      <skin_contact>脱去污染的衣着，用流动清水冲洗15分钟。若有灼伤，就医治疗。</skin_contact>
      <eye_contact>立即翻开上下眼睑，用流动清水冲洗15分钟。就医。</eye_contact>
      <inhalation>脱离现场至空气新鲜处。呼吸困难时给输氧。呼吸停止时，立即进行人工呼吸。就医。</inhalation>
      <ingestion>误服者漱口，给饮牛奶或蛋清。就医。</ingestion>
    </first_aid>
    <!-- 第五部分：消防措施 -->
    <fire_fighting>
      <hazard_characteristics>遇明火、高热、氧化剂能燃烧，并散发出有毒气体。受热或遇水、酸分解放热，放出有毒烟气。</hazard_characteristics>
      <fire_risk_classification>丙</fire_risk_classification>
      <harmful_combustion_products>一氧化碳、二氧化碳、氯化氢、光气。</harmful_combustion_products>
      <suitable_extinguishing_media>泡沫、二氧化碳、干粉、砂土。禁止用水。</suitable_extinguishing_media>
    </fire_fighting>
    <!-- 第六部分：泄漏应急处理 -->
    <leak_response>
      <emergency_procedures>疏散泄漏污染区人员至安全区，禁止无关人员进入污染区，切断火源。应急处理人员戴自给 式呼吸器，穿化学防护服。不要直接接触泄漏物，在确保安全情况下堵漏。用砂土、干燥石 灰或苏打灰混合，然后收集运至废物处理场所。如大量泄漏，利用围堤收容，然后收集、转 移、回收或无害处理后废弃。</emergency_procedures>
    </leak_response>
