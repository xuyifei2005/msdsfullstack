    <!-- 第二部分：危险性概述 -->
    <hazard_info>
      <hazard_category>第3类 易燃液体</hazard_category>
      <exposure_routes>吸入 食入 经皮吸收</exposure_routes>
      <health_hazards>吸入、食入、经皮吸收可引起中毒。对眼睛、皮肤、粘膜和上呼吸道有刺激作用。高浓度接触可引起头痛、头晕、恶心、呕吐、乏力等症状。长期接触可引起慢性中毒。</health_hazards>
      <environmental_hazards>对水生生物有毒，对水生环境可能会引起长期有害作用。</environmental_hazards>
      <fire_explosion_hazards>遇明火、高热可燃。受热分解产生有毒气体。其蒸气与空气可形成爆炸性混合物，遇明火、高热极易燃烧爆炸。</fire_explosion_hazards>
    </hazard_info>
