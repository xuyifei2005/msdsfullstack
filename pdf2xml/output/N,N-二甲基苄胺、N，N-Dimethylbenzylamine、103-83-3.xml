      <fire_risk_classification>乙</fire_risk_classification>
      <harmful_combustion_products>一氧化碳、二氧化碳、氮氧化物。</harmful_combustion_products>
      <suitable_extinguishing_media>雾状水、抗溶性泡沫、二氧化碳、干粉。</suitable_extinguishing_media>
    </fire_fighting>
