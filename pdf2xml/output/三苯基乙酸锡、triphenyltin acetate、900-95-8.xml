      <abbreviations_explanations>
        <!-- MSDS补全专家: 来源: 化学品安全术语标准, 2023-10-15 -->
        <abbreviation>
          <term>CAS</term>
          <explanation>Chemical Abstracts Service，化学文摘社，提供化学物质的唯一识别号</explanation>
        </abbreviation>
        <abbreviation>
          <term>TLV-TWA</term>
          <explanation>Threshold Limit Value - Time Weighted Average，时间加权平均阈限值</explanation>
        </abbreviation>
        <abbreviation>
          <term>TLV-STEL</term>
          <explanation>Threshold Limit Value - Short Term Exposure Limit，短时间接触阈限值</explanation>
        </abbreviation>
        <abbreviation>
          <term>LD50</term>
          <explanation>Lethal Dose 50%，半数致死量，能引起一半实验动物死亡的剂量</explanation>
        </abbreviation>
        <abbreviation>
          <term>LC50</term>
          <explanation>Lethal Concentration 50%，半数致死浓度，能引起一半实验动物死亡的浓度</explanation>
        </abbreviation>
        <abbreviation>
          <term>RTECS</term>
          <explanation>Registry of Toxic Effects of Chemical Substances，化学物质毒性效应登记</explanation>
        </abbreviation>
      </abbreviations_explanations>
