    <!-- 第四部分：急救措施 -->
    <first_aid>
      <skin_contact>脱去污染的衣着，用大量流动清水彻底冲洗。</skin_contact>
      <eye_contact>立即翻开上下眼睑，用流动清水或生理盐水冲洗。就医。</eye_contact>
      <inhalation>迅速脱离现场至空气新鲜处。保持呼吸道通畅。呼吸困难时给输氧；呼吸停止时，立即进行人工呼吸。就医。</inhalation>
      <ingestion>误服者漱口，饮牛奶或蛋清，就医。</ingestion>
    </first_aid>
    <!-- 第五部分：消防措施 -->
    <fire_fighting>
