    <hazard_info>
      <hazard_category>第8.1类 酸性腐蚀品</hazard_category>
      <exposure_routes>吸入 食入</exposure_routes>
      <health_hazards>水肿，化学性肺炎、肺水肿。接触后可引起咳嗽、喘息、烧灼感、气短、头痛、恶心和呕吐。</health_hazards>
      <environmental_hazards>无资料</environmental_hazards>
      <fire_explosion_hazards>本品不燃，具腐蚀性、强刺激性，可致人体灼伤。</fire_explosion_hazards>
    </hazard_info>
