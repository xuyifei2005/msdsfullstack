    <!-- 第二部分：危险性概述 -->
    <hazard_info>
      <hazard_category>第4.2类自燃物品</hazard_category>
      <exposure_routes>吸入、食入、经皮吸收</exposure_routes>
      <health_hazards>可引起镍皮炎，又称镍"痒疹"。皮肤剧痒，后出现丘疹、疱疹及红斑，重者化脓、溃烂。长期吸入镍粉可致呼吸道刺激、慢性鼻炎，甚至发生鼻中隔穿孔。尚可引起变态反应性肺炎、支气管炎、哮喘等。</health_hazards>
      <environmental_hazards>该物质对环境有危害，应特别注意对水体的污染。</environmental_hazards>
      <fire_explosion_hazards>本品属自燃物品，具刺激性，接触可引起皮炎，奇痒。粉尘可燃，能与空气形成爆炸性混合物。</fire_explosion_hazards>
    </hazard_info>
