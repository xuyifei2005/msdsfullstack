    <!-- 第四部分：急救措施 -->
    <first_aid>
      <eye_contact>立即提起眼睑，用大量流动清水或生理盐水彻底冲洗至少15分钟。就医。</eye_contact>
      <skin_contact>脱去污染的衣着，用肥皂水和大量清水彻底冲洗皮肤。如有不适，就医。</skin_contact>
      <inhalation>迅速脱离现场至空气新鲜处。保持呼吸道通畅。如呼吸困难，给输氧。如呼吸停止，立即进行人工呼吸。就医。</inhalation>
      <ingestion>用水漱口，禁止催吐。给饮牛奶或蛋清。就医。</ingestion>
    </first_aid>
    <!-- 第五部分：消防措施 -->
    <fire_fighting>
      <hazard_characteristics>遇明火、高热可燃。受热分解产生有毒的氮氧化物和氨气。</hazard_characteristics>
      <harmful_combustion_products>氮氧化物、氨气</harmful_combustion_products>
      <suitable_extinguishing_media>雾状水、泡沫、二氧化碳、干粉、砂土。</suitable_extinguishing_media>
      <firefighting_precautions>消防人员须佩戴防毒面具、穿全身消防服，在上风向灭火。尽可能将容器从火场移至空旷处。喷水保持火场容器冷却，直至灭火结束。</firefighting_precautions>
    </fire_fighting>
    <!-- 第六部分：泄漏应急处理 -->
    <leak_response>
      <emergency_procedures>隔离泄漏污染区，限制出入。建议应急处理人员戴防尘口罩，穿防毒服。避免扬尘，使用无火花工具收集于干燥、洁净、有盖的容器中。若大量泄漏，用塑料布、帆布覆盖。收集回收或运至废物处理场所处置。</emergency_procedures>
      <protective_equipment>建议应急处理人员戴携气式呼吸器，穿防静电服，戴橡胶耐油手套。</protective_equipment>
      <environmental_precautions>防止泄漏物进入下水道、地下室或限制性空间。</environmental_precautions>
      <cleanup_methods>避免扬尘，小心扫起，置于袋中转移至安全场所。若大量泄漏，用塑料布、帆布覆盖。</cleanup_methods>
    </leak_response>
    <!-- 第七部分：操作处置与储存 -->
    <handling_storage>
      <handling_precautions>密闭操作，局部排风。严格遵守操作规程。建议操作人员佩戴防尘面具（全面罩），穿胶布防毒衣，戴橡胶手套。远离火种、热源，工作场所严禁吸烟。避免产生粉尘。避免与氧化剂、酸类接触。配备相应品种和数量的消防器材及泄漏应急处理设备。</handling_precautions>
        <storage_precautions>保持容器密封，储存在阴凉、干燥、通风良好的地方。远离火种、热源。防止阳光直射。应与氧化剂、酸类分开存放，切忌混储。储区应备有合适的材料收容泄漏物。</storage_precautions>
    </handling_storage>
