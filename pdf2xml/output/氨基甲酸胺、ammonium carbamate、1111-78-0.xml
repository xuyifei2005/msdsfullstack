    <!-- 第二部分：危险性概述 -->
    <hazard_info>
      <hazard_category>急性毒性-经口，类别4；皮肤腐蚀/刺激，类别2；严重眼损伤/眼刺激，类别2</hazard_category>
      <exposure_routes>吸入、食入、皮肤接触、眼睛接触</exposure_routes>
      <health_hazards>吸入有毒。对眼睛、皮肤、粘膜和上呼吸道有刺激作用。接触可引起头痛、恶心和呕吐。</health_hazards>
      <environmental_hazards>对水生生物有毒。</environmental_hazards>
      <fire_explosion_hazards>遇明火、高热可燃。受热分解产生有毒的氮氧化物和氨气。</fire_explosion_hazards>
    </hazard_info>
