    <!-- 第二部分：危险性概述 -->
    <hazard_info>
      <hazard_category>第3.2类中闪点易燃液体</hazard_category>
      <exposure_routes>吸入、食入、眼睛及皮肤接触</exposure_routes>
      <health_hazards>吸入、摄入或经皮肤吸收后对身体有害。对眼睛、皮肤有刺激性。</health_hazards>
      <environmental_hazards>对水生生物有害。</environmental_hazards>
      <fire_explosion_hazards>易燃，遇明火、高热或与氧化剂接触，有引起燃烧爆炸的危险。其蒸气比空气重，能在较低处扩散到相当远的地方，遇火源会着火回燃。</fire_explosion_hazards>
    </hazard_info>
    <!-- 第三部分：成分/组成信息 -->
    <component_info>
      <components>3-辛酮；CAS号：106-68-3；浓度：≥99%</components>
    </component_info>
    <!-- 第四部分：急救措施 -->
    <first_aid>
      <skin_contact>脱去污染的衣着，用肥皂水和清水彻底冲洗皮肤。就医。</skin_contact>
      <eye_contact>立即提起眼睑，用大量流动清水或生理盐水彻底冲洗至少15分钟。就医。</eye_contact>
      <inhalation>迅速脱离现场至空气新鲜处。保持呼吸道通畅。如呼吸困难，给输氧。如呼吸停止，立即进行人工呼吸。就医。</inhalation>
      <ingestion>误服者立即漱口，给饮牛奶或蛋清。就医。</ingestion>
    </first_aid>
    <!-- 第五部分：消防措施 -->
    <fire_fighting>
      <hazard_characteristics>易燃液体和蒸气。遇明火、高热或与氧化剂接触，有引起燃烧爆炸的危险。其蒸气比空气重，能在较低处扩散到相当远的地方，遇火源会着火回燃。</hazard_characteristics>
      <fire_risk_classification>第3.2类中闪点易燃液体</fire_risk_classification>
      <harmful_combustion_products>一氧化碳、二氧化碳</harmful_combustion_products>
      <suitable_extinguishing_media>使用泡沫、干粉、二氧化碳或砂土灭火。用水灭火无效。消防人员须佩戴防毒面具、穿全身消防服，在上风向灭火。尽可能将容器从火场移至空旷处。喷水冷却容器，使温度低于物质的闪点。</suitable_extinguishing_media>
    </fire_fighting>
    <!-- 第六部分：泄漏应急处理 -->
    <leak_response>
      <emergency_procedures>须穿戴防护用具进入现场；排除一切火情隐患，现场通风；不得将泄漏物排入下水道，以 免爆炸；用蛭石、干砂、泥土或类似吸附剂吸附液体泄漏物并放置密闭容器内</emergency_procedures>
    </leak_response>
    <!-- 第七部分：操作处置与储存 -->
    <handling_storage>
      <handling_precautions>有金属部件都要接地。使用防爆设备。在通风良好处进行操作。穿戴合适的个人防护用具。</handling_precautions>
      <storage_precautions>避免接触皮肤和进入眼睛。远离热源、火花、明火和热表面。采取措施防止静电积累。 存于密闭容器内，置于凉爽、通风处，避免接触氧化剂，开启和关闭容器时应使用无火花 工具，储藏处应使用防爆电子设备和装置。</storage_precautions>
    </handling_storage>
