    <!-- 第四部分：急救措施 -->
    <first_aid>
      <skin_contact>脱去污染的衣着，立即用肥皂水及流动清水冲洗受污染的皮肤。</skin_contact>
      <eye_contact>立即翻开上下眼睑，用流动清水冲洗，至少15分钟。就医。</eye_contact>
      <inhalation>脱离现场至空气新鲜处。就医。</inhalation>
      <ingestion>误服者漱口，用1：5000的高锰酸钾或5％硫代硫酸钠洗胃。就医。</ingestion>
    </first_aid>
    <!-- 第五部分：消防措施 -->
    <fire_fighting>
