    <!-- 第二部分：危险性概述 -->
    <hazard_info>
      <hazard_category>第3.3类高闪点易燃液体</hazard_category>
      <exposure_routes>吸入食入经皮吸收</exposure_routes>
      <health_hazards>吸入、口服或经皮肤吸收对身体有害。对眼睛、皮肤、粘膜和上呼吸道有刺激性。长期接触可引起皮炎。</health_hazards>
      <environmental_hazards>对环境可能有危害，对水体应给予特别注意。</environmental_hazards>
      <fire_explosion_hazards>本品易燃，具刺激性。</fire_explosion_hazards>
    </hazard_info>
