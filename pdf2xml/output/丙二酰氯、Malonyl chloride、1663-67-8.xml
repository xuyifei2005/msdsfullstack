    <!-- 第二部分：危险性概述 -->
    <hazard_info>
      <hazard_category>第8.1类 酸性腐蚀品</hazard_category>
      <exposure_routes>吸入、食入、经皮吸收</exposure_routes>
      <health_hazards>对眼睛、皮肤、粘膜有强刺激性，可引起皮肤灼伤。吸入后可引起喉炎、化学性肺炎、肺水肿等。接触后的症状：烧灼感、咳嗽、眩晕、气短、头痛、恶心和呕吐等。遇水分解释出有刺激性和腐蚀性的氯化氢烟雾。</health_hazards>
      <environmental_hazards>无资料</environmental_hazards>
      <fire_explosion_hazards>本品易燃、有毒、具有强腐蚀性、刺激性、可致人体灼伤</fire_explosion_hazards>
    </hazard_info>
