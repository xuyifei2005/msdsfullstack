    <!-- 第四部分：急救措施 -->
    <first_aid>
      <skin_contact>立即脱去污染的衣着，用大量流动清水冲洗至少15分钟。就医。</skin_contact>
      <eye_contact>立即提起眼睑，用大量流动清水或生理盐水彻底冲洗至少15分钟。就医。</eye_contact>
      <inhalation>迅速脱离现场至空气新鲜处。保持呼吸道通畅。如呼吸困难，给输氧。如呼吸停止，立即进行 人工呼吸。就医。</inhalation>
      <ingestion>用水漱口，给饮牛奶或蛋清。就医。</ingestion>
    </first_aid>
    <!-- 第五部分：消防措施 -->
    <fire_fighting>
      <hazard_characteristics>露置空气中冒烟, 加热更甚, 有强烈的刺激性和腐蚀性。遇水发生剧烈反应，散发出白色有强 刺激性和腐蚀性的氟化氢烟雾。遇潮时对玻璃、其它硅质材料及大多数金属有强腐蚀性。</hazard_characteristics>
      <fire_risk_classification>无资料</fire_risk_classification>
      <harmful_combustion_products>氟化氢、氧化硫。</harmful_combustion_products>
      <suitable_extinguishing_media>消防人员必须穿全身耐酸碱消防服。灭火剂：二氧化碳、砂土。禁止用水和泡沫灭火。</suitable_extinguishing_media>
    </fire_fighting>
    <!-- 第六部分：泄漏应急处理 -->
    <leak_response>
      <emergency_procedures>迅速撤离泄漏污染区人员至安全区，并进行隔离，严格限制出入。建议应急处理人员戴自给正 压式呼吸器，穿防酸碱工作服。不要直接接触泄漏物。尽可能切断泄漏源。小量泄漏：用砂土、 蛭石或其它惰性材料吸收。大量泄漏：构筑围堤或挖坑收容。在专家指导下清除。</emergency_procedures>
    </leak_response>
    <!-- 第七部分：操作处置与储存 -->
    <handling_storage>
      <handling_precautions>手套。防止蒸气泄漏到工作场所空气中。避免与碱类、醇类、活性金属粉末接触。尤其要注意</handling_precautions>
      <storage_precautions>作规程。建议操作人员佩戴自吸过滤式防毒面具（全面罩），穿橡胶耐酸碱服，戴橡胶耐酸碱 避免与水接触。搬运时要轻装轻卸，防止包装及容器损坏。配备泄漏应急处理设备。倒空的容 器可能残留有害物。 储存于阴凉、干燥、通风良好的库房。远离火种、热源。包装必须密封，切勿受潮。应与碱类、 醇类、活性金属粉末等分开存放，切忌混储。储区应备有泄漏应急处理设备和合适的收容材料。</storage_precautions>
    </handling_storage>
