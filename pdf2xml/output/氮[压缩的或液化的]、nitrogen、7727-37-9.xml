    <!-- 第二部分：危险性概述 -->
    <hazard_info>
        <hazard_category>第2.2类不燃气体</hazard_category>
        <exposure_routes>吸入</exposure_routes>
        <health_hazards>空气中氮气含量过高，使吸入气氧分压下降，引起缺氧窒息。吸入氮气浓度不太高时，患者最初感胸闷、气短、疲软无力；继而有烦躁不安、极度兴奋、乱跑、叫喊、神情恍惚、步态不稳，可能出现进入昏迷状态。如果吸入浓度很高，可迅速昏迷、因呼吸和心跳停止而死亡。</health_hazards>
        <environmental_hazards>该物质对环境无危害。</environmental_hazards>
        <fire_explosion_hazards>本品不燃。若遇高热，容器内压增大，有开裂和爆炸的危险。</fire_explosion_hazards>
      </hazard_info>
    <!-- 第三部分：成分/组成信息 -->
