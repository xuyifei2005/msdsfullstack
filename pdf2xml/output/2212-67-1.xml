      <china_mac>无资料</china_mac>
      <engineering_controls>生产过程密闭，加强通风。提供安全淋浴和洗眼设备。</engineering_controls>
      <respiratory_protection>空气中浓度超标时，必须佩戴自吸过滤式防毒面具（半面罩）。紧急事态抢救或撤离时，应该佩戴空气呼吸器。</respiratory_protection>
      <eye_protection>戴化学安全防护眼镜。</eye_protection>
      <body_protection>穿防毒物渗透工作服。</body_protection>
      <hand_protection>戴橡胶耐油手套。</hand_protection>
    </exposure_control>

