    <hazard_info>
      <hazard_category>第5.1类氧化剂</hazard_category>
      <exposure_routes>吸入、食入</exposure_routes>
      <health_hazards>口服急性中毒，表现为高铁血红蛋白血症，胃肠炎，肝肾损伤，甚至窒息。对眼睛、皮肤、粘膜和上呼吸道有刺激作用。</health_hazards>
      <environmental_hazards>对水体可造成污染。</environmental_hazards>
      <fire_explosion_hazards>本品助燃。遇明火、高热可燃。受热分解产生有毒气体。</fire_explosion_hazards>
    </hazard_info>
