# 前端生产环境Nginx Dockerfile
# 用于构建前端静态文件镜像

# ===== 构建阶段 =====
FROM node:18-alpine AS builder

WORKDIR /app

# 复制package文件
COPY package*.json ./

# 创建干净的package.json只包含name、version、dependencies和devDependencies，避免scripts执行
RUN node -e "const pkg=require('./package.json'); const clean={name:pkg.name,version:pkg.version,dependencies:pkg.dependencies,devDependencies:pkg.devDependencies}; require('fs').writeFileSync('package.json', JSON.stringify(clean, null, 2))" && \
    npm install && \
    npm cache clean --force

# 复制源代码
COPY . .

# 构建生产版本
RUN npm run build:prod

# 验证构建产物是否存在
RUN ls -la /app/dist || (echo "前端构建失败，dist目录不存在！" && exit 1)
RUN test -f /app/dist/index.html || (echo "index.html不存在，构建失败！" && exit 1)

# ===== 运行阶段 =====
FROM nginx:alpine

# 维护者信息
LABEL maintainer="MSDS Team"
LABEL description="MSDS Frontend Nginx Container"

# 复制构建产物到Nginx目录
COPY --from=builder /app/dist /usr/share/nginx/html

# 验证文件复制成功
RUN ls -la /usr/share/nginx/html || (echo "文件复制失败！" && exit 1)
RUN test -f /usr/share/nginx/html/index.html || (echo "index.html复制失败！" && exit 1)

# 复制Nginx配置文件
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# 创建日志目录
RUN mkdir -p /var/log/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /usr/share/nginx/html

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# 暴露端口
EXPOSE 80

# 启动Nginx
CMD ["nginx", "-g", "daemon off;"]

