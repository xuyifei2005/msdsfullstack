<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MsdsFeedbackMapper">
    
    <resultMap type="MsdsFeedback" id="MsdsFeedbackResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="feedbackType"    column="feedback_type"    />
        <result property="content"    column="content"    />
        <result property="contactInfo"    column="contact_info"    />
        <result property="images"    column="images"    />
        <result property="status"    column="status"    />
        <result property="replyContent"    column="reply_content"    />
        <result property="replyBy"    column="reply_by"    />
        <result property="replyTime"    column="reply_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMsdsFeedbackVo">
        select id, user_id, user_name, feedback_type, content, contact_info, images, status, reply_content, reply_by, reply_time, create_by, create_time, update_by, update_time, remark from msds_feedback
    </sql>

    <select id="selectMsdsFeedbackList" parameterType="MsdsFeedback" resultMap="MsdsFeedbackResult">
        <include refid="selectMsdsFeedbackVo"/>
        <where>  
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectMsdsFeedbackById" parameterType="Long" resultMap="MsdsFeedbackResult">
        <include refid="selectMsdsFeedbackVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertMsdsFeedback" parameterType="MsdsFeedback" useGeneratedKeys="true" keyProperty="id">
        insert into msds_feedback
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="feedbackType != null">feedback_type,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="contactInfo != null">contact_info,</if>
            <if test="images != null">images,</if>
            <if test="status != null">status,</if>
            <if test="replyContent != null">reply_content,</if>
            <if test="replyBy != null">reply_by,</if>
            <if test="replyTime != null">reply_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="feedbackType != null">#{feedbackType},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="contactInfo != null">#{contactInfo},</if>
            <if test="images != null">#{images},</if>
            <if test="status != null">#{status},</if>
            <if test="replyContent != null">#{replyContent},</if>
            <if test="replyBy != null">#{replyBy},</if>
            <if test="replyTime != null">#{replyTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateMsdsFeedback" parameterType="MsdsFeedback">
        update msds_feedback
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="feedbackType != null">feedback_type = #{feedbackType},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="contactInfo != null">contact_info = #{contactInfo},</if>
            <if test="images != null">images = #{images},</if>
            <if test="status != null">status = #{status},</if>
            <if test="replyContent != null">reply_content = #{replyContent},</if>
            <if test="replyBy != null">reply_by = #{replyBy},</if>
            <if test="replyTime != null">reply_time = #{replyTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMsdsFeedbackById" parameterType="Long">
        delete from msds_feedback where id = #{id}
    </delete>

    <delete id="deleteMsdsFeedbackByIds" parameterType="String">
        delete from msds_feedback where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
