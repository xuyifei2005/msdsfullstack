<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MsdsMainMapper">
    
    <resultMap type="MsdsMain" id="MsdsMainResult">
        <id     property="id"                   column="id"                   />
        <result property="productName"          column="product_name"          />
        <result property="productAlias"         column="product_alias"         />
        <result property="productEnglishName"   column="product_english_name"   />
        <result property="companyName"          column="company_name"          />
        <result property="companyAddress"       column="company_address"       />
        <result property="zipCode"              column="zip_code"              />
        <result property="faxNumber"            column="fax_number"            />
        <result property="contactPhone"         column="contact_phone"         />
        <result property="email"                column="email"                />
        <result property="emergencyPhone"       column="emergency_phone"       />
        <result property="recommendedUsage"     column="recommended_usage"     />
        <result property="restrictedUsage"      column="restricted_usage"      />
        <result property="version"              column="version"              />
        <result property="isActive"             column="is_active"             />
        <result property="createBy"             column="create_by"             />
        <result property="createTime"           column="create_time"           />
        <result property="updateBy"             column="update_by"             />
        <result property="updateTime"           column="update_time"           />
        <result property="remark"               column="remark"               />
    </resultMap>
    
    <sql id="selectMsdsMainVo">
        select id, product_name, product_alias, product_english_name, company_name, 
               company_address, zip_code, fax_number, contact_phone, email, 
               emergency_phone, recommended_usage, restricted_usage, version, 
               is_active, create_by, create_time, update_by, update_time, remark
        from msds_main
    </sql>
    
    <select id="selectMsdsMainById" parameterType="Long" resultMap="MsdsMainResult">
        <include refid="selectMsdsMainVo"/>
        where id = #{id}
    </select>
    
    <select id="selectMsdsMainList" parameterType="MsdsMain" resultMap="MsdsMainResult">
        <include refid="selectMsdsMainVo"/>
        <where>
            <if test="productName != null and productName != ''">
                AND product_name like concat('%', #{productName}, '%')
            </if>
            <if test="companyName != null and companyName != ''">
                AND company_name like concat('%', #{companyName}, '%')
            </if>
            <if test="isActive != null">
                AND is_active = #{isActive}
            </if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectMsdsMainByProductName" parameterType="String" resultMap="MsdsMainResult">
        <include refid="selectMsdsMainVo"/>
        where product_name = #{productName} and is_active = 1 limit 1
    </select>
    
    <select id="checkProductNameUnique" parameterType="String" resultMap="MsdsMainResult">
        <include refid="selectMsdsMainVo"/>
        where product_name = #{productName} limit 1
    </select>
    
    <select id="selectMsdsMainByCompany" parameterType="String" resultMap="MsdsMainResult">
        <include refid="selectMsdsMainVo"/>
        where company_name like concat('%', #{companyName}, '%') and is_active = 1
        order by create_time desc
    </select>
    
    <select id="countActiveMsds" resultType="int">
        select count(*) from msds_main where is_active = 1
    </select>
    
    <insert id="insertMsdsMain" parameterType="MsdsMain" useGeneratedKeys="true" keyProperty="id">
        insert into msds_main (
            product_name, company_name, contact_phone, 
            product_alias, product_english_name, company_address, 
            zip_code, fax_number, email, emergency_phone, 
            recommended_usage, restricted_usage, version, 
            is_active, create_by, create_time, remark
        )values(
            #{productName}, #{companyName}, #{contactPhone},
            #{productAlias}, #{productEnglishName}, #{companyAddress},
            #{zipCode}, #{faxNumber}, #{email}, #{emergencyPhone},
            #{recommendedUsage}, #{restrictedUsage}, #{version},
            #{isActive}, #{createBy}, sysdate(), #{remark}
        )
    </insert>
     
    <update id="updateMsdsMain" parameterType="MsdsMain">
        update msds_main 
        <set>
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="companyName != null and companyName != ''">company_name = #{companyName},</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone = #{contactPhone},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>
    
    <delete id="deleteMsdsMainById" parameterType="Long">
        delete from msds_main where id = #{id}
    </delete>
    
    <delete id="deleteMsdsMainByIds" parameterType="Long">
        delete from msds_main where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>
