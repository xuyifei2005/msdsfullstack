<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MsdsUserFavoriteMapper">

    <resultMap type="MsdsUserFavorite" id="MsdsUserFavoriteResult">
        <id     property="favoriteId"  column="favorite_id"  />
        <result property="userId"      column="user_id"      />
        <result property="userName"    column="user_name"    />
        <result property="msdsId"      column="msds_id"      />
        <result property="msdsName"    column="msds_name"    />
        <result property="casNumber"   column="cas_number"   />
        <result property="folderName"  column="folder_name"  />
        <result property="tags"        column="tags"         />
        <result property="note"        column="note"         />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectMsdsUserFavoriteVo">
        select favorite_id, user_id, user_name, msds_id, msds_name, cas_number,
               folder_name, tags, note, create_by, create_time, update_by, update_time, remark
        from msds_user_favorite
    </sql>

    <select id="selectMsdsUserFavoriteByFavoriteId" parameterType="Long" resultMap="MsdsUserFavoriteResult">
        <include refid="selectMsdsUserFavoriteVo"/>
        where favorite_id = #{favoriteId}
    </select>

    <select id="selectMsdsUserFavoriteList" parameterType="MsdsUserFavorite" resultMap="MsdsUserFavoriteResult">
        <include refid="selectMsdsUserFavoriteVo"/>
        <where>
            <if test="userId != null"> AND user_id = #{userId}</if>
            <if test="msdsId != null"> AND msds_id = #{msdsId}</if>
            <if test="msdsName != null and msdsName != ''"> AND msds_name like concat('%', #{msdsName}, '%')</if>
            <if test="casNumber != null and casNumber != ''"> AND cas_number = #{casNumber}</if>
            <if test="folderName != null and folderName != ''"> AND folder_name = #{folderName}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectByUserAndMsds" resultMap="MsdsUserFavoriteResult">
        <include refid="selectMsdsUserFavoriteVo"/>
        where user_id = #{userId} and msds_id = #{msdsId}
        limit 1
    </select>

    <insert id="insertMsdsUserFavorite" parameterType="MsdsUserFavorite" useGeneratedKeys="true" keyProperty="favoriteId">
        insert into msds_user_favorite
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="msdsId != null">msds_id,</if>
            <if test="msdsName != null and msdsName != ''">msds_name,</if>
            <if test="casNumber != null and casNumber != ''">cas_number,</if>
            <if test="folderName != null and folderName != ''">folder_name,</if>
            <if test="tags != null and tags != ''">tags,</if>
            <if test="note != null and note != ''">note,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="msdsId != null">#{msdsId},</if>
            <if test="msdsName != null and msdsName != ''">#{msdsName},</if>
            <if test="casNumber != null and casNumber != ''">#{casNumber},</if>
            <if test="folderName != null and folderName != ''">#{folderName},</if>
            <if test="tags != null and tags != ''">#{tags},</if>
            <if test="note != null and note != ''">#{note},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <update id="updateMsdsUserFavorite" parameterType="MsdsUserFavorite">
        update msds_user_favorite
        <trim prefix="SET" suffixOverrides=",">
            <if test="msdsName != null and msdsName != ''">msds_name = #{msdsName},</if>
            <if test="casNumber != null and casNumber != ''">cas_number = #{casNumber},</if>
            <if test="folderName != null and folderName != ''">folder_name = #{folderName},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="note != null">note = #{note},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where favorite_id = #{favoriteId}
    </update>

    <delete id="deleteByUserAndMsds">
        delete from msds_user_favorite where user_id = #{userId} and msds_id = #{msdsId}
    </delete>

    <delete id="deleteMsdsUserFavoriteByFavoriteIds" parameterType="String">
        delete from msds_user_favorite where favorite_id in
        <foreach item="favoriteId" collection="array" open="(" separator="," close=")">
            #{favoriteId}
        </foreach>
    </delete>
</mapper>
