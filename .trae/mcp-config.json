{
  "mcpServers": {
    "mysql": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-mysql"],
      "env": {
        "MYSQL_HOST": "msdsmysql",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "msds_user",
        "MYSQL_PASSWORD": "msds_dev_password",
        "MYSQL_DATABASE": "msds_dev"
      }
    },
    "redis": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-redis"],
      "env": {
        "REDIS_HOST": "msdsredis",
        "REDIS_PORT": "6379"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "d:\\XUYIFEI\\XUPROJECTS\\msdsfullstack"]
    },
    "nginx": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-nginx"],
      "env": {
        "NGINX_CONFIG_PATH": "d:\\XUYIFEI\\XUPROJECTS\\msdsfullstack\\msdsdocker\\nginx\\conf.d"
      }
    },
    "msds-processor": {
      "command": "python",
      "args": ["d:\\XUYIFEI\\XUPROJECTS\\msdsfullstack\\pdf2xml\\msds_parser.py"],
      "env": {
        "MSDS_DATA_DIR": "d:\\XUYIFEI\\XUPROJECTS\\msdsfullstack\\test_msds_files",
        "OUTPUT_FORMAT": "xml"
      }
    },
    "api-monitor": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-http"],
      "env": {
        "BASE_URL": "http://localhost:18080",
        "AUTH_TOKEN": ""
      }
    }
  }
}
